{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@creator/*": ["../frontend-creator/src/*"],
      "@admin/*": ["../frontend-admin/src/*"]
    }
  },
  "include": ["src", "../frontend-creator/src", "../frontend-admin/src"]
}
